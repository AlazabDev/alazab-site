:root {
  --receipt-navy: #030957;
  --receipt-yellow: #ffb900;
  --receipt-background: #edf0f6;
  --receipt-surface: #ffffff;
  --receipt-text: #171923;
  --receipt-muted: #667085;
  --receipt-border: rgba(3, 9, 87, 0.15);
  --receipt-shadow: 0 18px 55px rgba(3, 9, 87, 0.14);
}

.receipt-viewer {
  min-height: 100vh;
  padding-bottom: 24px;
  color: var(--receipt-text);
  background:
    radial-gradient(
      circle at top right,
      rgba(255, 185, 0, 0.13),
      transparent 30rem
    ),
    var(--receipt-background);
}

.receipt-viewer:fullscreen {
  overflow: auto;
  background: var(--receipt-background);
}

.receipt-toolbar {
  position: sticky;
  top: 0;
  z-index: 50;
  display: grid;
  grid-template-columns:
    minmax(230px, 1fr)
    auto
    minmax(360px, 1fr);
  align-items: center;
  gap: 16px;
  padding: 13px clamp(14px, 2.5vw, 34px);
  border-bottom: 1px solid var(--receipt-border);
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 8px 28px rgba(3, 9, 87, 0.08);
  backdrop-filter: blur(18px);
}

.receipt-toolbar__title {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 11px;
  color: var(--receipt-navy);
}

.receipt-toolbar__title h1 {
  overflow: hidden;
  margin: 0;
  font-size: clamp(1rem, 2vw, 1.35rem);
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.receipt-toolbar__title p {
  margin: 2px 0 0;
  color: var(--receipt-muted);
  font-size: 0.77rem;
}

.receipt-view-selector {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 5px;
  border: 1px solid var(--receipt-border);
  border-radius: 14px;
  background: #f7f8fb;
}

.receipt-view-button {
  display: inline-flex;
  min-width: 54px;
  height: 40px;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: var(--receipt-muted);
  font: inherit;
  font-weight: 800;
  cursor: pointer;
  transition:
    color 160ms ease,
    background-color 160ms ease,
    transform 160ms ease;
}

.receipt-view-button:hover {
  color: var(--receipt-navy);
}

.receipt-view-button--active {
  background: var(--receipt-navy);
  color: #ffffff;
  box-shadow: 0 7px 18px rgba(3, 9, 87, 0.22);
}

.receipt-view-button:active {
  transform: scale(0.97);
}

.receipt-toolbar__tools {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6px;
}

.receipt-icon-button,
.receipt-zoom-value {
  display: inline-grid;
  min-width: 40px;
  height: 40px;
  place-items: center;
  border: 1px solid var(--receipt-border);
  border-radius: 10px;
  background: var(--receipt-surface);
  color: var(--receipt-navy);
  font: inherit;
  font-weight: 800;
  text-decoration: none;
  cursor: pointer;
  transition:
    border-color 160ms ease,
    background-color 160ms ease,
    transform 160ms ease;
}

.receipt-icon-button:hover:not(:disabled),
.receipt-zoom-value:hover {
  border-color: var(--receipt-yellow);
  background: rgba(255, 185, 0, 0.12);
}

.receipt-icon-button:active:not(:disabled),
.receipt-zoom-value:active {
  transform: scale(0.96);
}

.receipt-icon-button:disabled {
  cursor: not-allowed;
  opacity: 0.35;
}

.receipt-zoom-value {
  min-width: 64px;
  padding-inline: 8px;
}

.receipt-jump {
  display: flex;
  height: 40px;
  align-items: center;
  gap: 5px;
  padding: 4px 5px 4px 9px;
  border: 1px solid var(--receipt-border);
  border-radius: 10px;
  background: #ffffff;
  color: var(--receipt-muted);
}

.receipt-jump input {
  width: 60px;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--receipt-navy);
  font: inherit;
  font-weight: 800;
  text-align: center;
}

.receipt-jump button {
  height: 30px;
  padding-inline: 11px;
  border: 0;
  border-radius: 7px;
  background: var(--receipt-yellow);
  color: var(--receipt-navy);
  font: inherit;
  font-size: 0.75rem;
  font-weight: 900;
  cursor: pointer;
}

.receipt-grid {
  display: grid;
  width: min(100%, 1920px);
  margin-inline: auto;
  gap: clamp(12px, 1.7vw, 24px);
  padding: clamp(14px, 2.5vw, 32px);
}

.receipt-grid[data-view="1"] {
  max-width: 1120px;
  grid-template-columns: minmax(0, 1fr);
}

.receipt-grid[data-view="2"] {
  max-width: 1800px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.receipt-grid[data-view="4"] {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.receipt-card {
  display: grid;
  min-width: 0;
  grid-template-rows: auto minmax(0, 1fr) auto;
  overflow: hidden;
  border: 1px solid var(--receipt-border);
  border-radius: 17px;
  background: var(--receipt-surface);
  box-shadow: var(--receipt-shadow);
}

.receipt-grid[data-view="1"] .receipt-card {
  height: clamp(620px, 80vh, 1150px);
}

.receipt-grid[data-view="2"] .receipt-card {
  height: clamp(580px, 74vh, 1000px);
}

.receipt-grid[data-view="4"] .receipt-card {
  height: clamp(390px, 44vh, 660px);
}

.receipt-card__header,
.receipt-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 9px 13px;
  background: #ffffff;
}

.receipt-card__header {
  border-bottom: 1px solid var(--receipt-border);
}

.receipt-card__footer {
  border-top: 1px solid var(--receipt-border);
  color: var(--receipt-muted);
  font-size: 0.74rem;
}

.receipt-card__header > div:first-child {
  min-width: 0;
}

.receipt-card__header strong {
  display: block;
  color: var(--receipt-navy);
  font-size: 0.86rem;
}

.receipt-card__header span {
  display: block;
  overflow: hidden;
  margin-top: 2px;
  color: var(--receipt-muted);
  font-size: 0.68rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.receipt-card__actions {
  display: flex;
  flex-shrink: 0;
  gap: 5px;
}

.receipt-card__actions .receipt-icon-button {
  min-width: 35px;
  width: 35px;
  height: 35px;
}

.receipt-card__viewport {
  position: relative;
  display: flex;
  min-height: 0;
  align-items: flex-start;
  justify-content: center;
  overflow: auto;
  background:
    linear-gradient(45deg, #e6e8ee 25%, transparent 25%),
    linear-gradient(-45deg, #e6e8ee 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #e6e8ee 75%),
    linear-gradient(-45deg, transparent 75%, #e6e8ee 75%),
    #f7f8fa;
  background-position:
    0 0,
    0 10px,
    10px -10px,
    -10px 0;
  background-size: 20px 20px;
  overscroll-behavior: contain;
}

.receipt-card__canvas {
  min-width: 100%;
  transition: width 180ms ease;
}

.receipt-card__image {
  display: block;
  width: 100%;
  height: auto;
  opacity: 0;
  user-select: none;
  transition: opacity 180ms ease;
}

.receipt-card__image--loaded {
  opacity: 1;
}

.receipt-card__message {
  position: absolute;
  inset: 0;
  display: grid;
  place-content: center;
  justify-items: center;
  gap: 10px;
  padding: 24px;
  color: var(--receipt-muted);
  text-align: center;
}

.receipt-card__error strong {
  color: var(--receipt-navy);
}

.receipt-card__error a {
  color: var(--receipt-navy);
  font-weight: 800;
}

.receipt-spinner {
  width: 36px;
  height: 36px;
  border: 3px solid rgba(3, 9, 87, 0.13);
  border-top-color: var(--receipt-yellow);
  border-radius: 50%;
  animation: receipt-spin 0.8s linear infinite;
}

.receipt-navigation {
  display: grid;
  width: min(calc(100% - 28px), 900px);
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 13px;
  margin: 0 auto;
  padding: 11px;
  border: 1px solid var(--receipt-border);
  border-radius: 16px;
  background: var(--receipt-surface);
  box-shadow: 0 14px 34px rgba(3, 9, 87, 0.1);
}

.receipt-navigation__button {
  display: inline-flex;
  min-width: 120px;
  height: 44px;
  align-items: center;
  justify-content: center;
  gap: 7px;
  border: 0;
  border-radius: 11px;
  background: var(--receipt-navy);
  color: #ffffff;
  font: inherit;
  font-weight: 800;
  cursor: pointer;
}

.receipt-navigation__button:disabled {
  cursor: not-allowed;
  opacity: 0.32;
}

.receipt-navigation__center {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: center;
  gap: 13px;
  color: var(--receipt-navy);
  font-size: 0.85rem;
}

.receipt-navigation__center button {
  border: 0;
  background: transparent;
  color: var(--receipt-muted);
  font: inherit;
  font-size: 0.74rem;
  cursor: pointer;
}

.receipt-navigation__center button:hover {
  color: var(--receipt-navy);
  text-decoration: underline;
}

.receipt-shortcuts {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 7px 16px;
  margin-top: 13px;
  padding-inline: 15px;
  color: var(--receipt-muted);
  font-size: 0.7rem;
}

.receipt-viewer button:focus-visible,
.receipt-viewer a:focus-visible,
.receipt-viewer input:focus-visible {
  outline: 3px solid rgba(255, 185, 0, 0.75);
  outline-offset: 3px;
}

@keyframes receipt-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (max-width: 1150px) {
  .receipt-toolbar {
    grid-template-columns: minmax(220px, 1fr) auto;
  }

  .receipt-view-selector {
    grid-column: 1 / -1;
    grid-row: 2;
    justify-self: center;
  }

  .receipt-toolbar__tools {
    grid-column: 2;
    grid-row: 1;
  }
}

@media (max-width: 760px) {
  .receipt-toolbar {
    position: relative;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
  }

  .receipt-toolbar__title,
  .receipt-view-selector,
  .receipt-toolbar__tools {
    grid-column: 1;
    grid-row: auto;
    justify-self: stretch;
  }

  .receipt-view-selector,
  .receipt-toolbar__tools {
    justify-content: center;
  }

  .receipt-toolbar__tools {
    flex-wrap: wrap;
  }

  .receipt-grid[data-view="2"],
  .receipt-grid[data-view="4"] {
    grid-template-columns: minmax(0, 1fr);
  }

  .receipt-grid[data-view="1"] .receipt-card,
  .receipt-grid[data-view="2"] .receipt-card,
  .receipt-grid[data-view="4"] .receipt-card {
    height: 75vh;
    min-height: 560px;
  }

  .receipt-navigation {
    grid-template-columns: 1fr 1fr;
  }

  .receipt-navigation__button {
    min-width: 0;
  }

  .receipt-navigation__center {
    grid-column: 1 / -1;
    grid-row: 2;
  }
}

@media (max-width: 430px) {
  .receipt-toolbar {
    padding-inline: 10px;
  }

  .receipt-toolbar__title h1 {
    font-size: 0.95rem;
  }

  .receipt-view-button {
    min-width: 49px;
  }

  .receipt-grid {
    padding: 10px;
  }

  .receipt-card {
    border-radius: 12px;
  }

  .receipt-jump {
    width: 100%;
    justify-content: center;
  }
}

@media (prefers-reduced-motion: reduce) {
  .receipt-spinner {
    animation-duration: 1.8s;
  }

  .receipt-card__canvas,
  .receipt-card__image,
  .receipt-icon-button,
  .receipt-view-button {
    transition: none;
  }
}
