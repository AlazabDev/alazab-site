[Unit]
Description=Alazab Meta MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/www/core/alazab-site/server
EnvironmentFile=-/var/www/core/alazab-site/server/.env
ExecStart=/usr/bin/node mcp/meta/src/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
