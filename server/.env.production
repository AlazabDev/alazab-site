# ==============================
# CORE
# ==============================

NODE_ENV=production
PORT=3004
FRONTEND_URL=https://alazab.com

# ==============================
# DATABASE
# ==============================

DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5434/DATABASE

# ==============================
# SUPABASE SERVER
# ==============================

SUPABASE_URL=https://bxuhcbfdoaflsgbxiqei.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ==============================
# SECURITY
# ==============================

ADMIN_API_KEY=

# ==============================
# META / WHATSAPP
# ==============================

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=

META_APP_SECRET=

# ==============================
# ELEVENLABS
# ==============================

ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

# ==============================
# TELEGRAM
# ==============================

TELEGRAM_BOT_TOKEN=

# ==============================
# VONAGE
# ==============================

VONAGE_SIGNATURE_SECRET=
VONAGE_VERIFY_WEBHOOK_URL=https://api.alazab.com/api/vonage/verify/status
VONAGE_TELEGRAM_CHAT_ID=

# ==============================
# STRIPE
# ==============================

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

DEFAULT_CURRENCY=egp
DEFAULT_TAX_RATE=0

# ==============================
# DAFTRA MCP
# ==============================

MCP_DAFTRA_HOST=127.0.0.1
MCP_DAFTRA_PORT=4007
MCP_DAFTRA_API_KEY=
MCP_DAFTRA_TIMEOUT_MS=60000
MCP_DAFTRA_MAX_RESPONSE_BYTES=26214400

DAFTRA_OPENAPI_FILE=./mcp/daftra/openapi/Default module.openapi.json
DAFTRA_OPENAPI_EXPECT_OPERATIONS=301
DAFTRA_OPENAPI_STRICT_HASH=true

DAFTRA_MCP_AUDIT_FILE=./logs/daftra-mcp-audit.jsonl
DAFTRA_MCP_EXPOSE_GROUP_TOOLS=false

DAFTRA_SUBDOMAIN=alazab-co
DAFTRA_BASE_URL=
DAFTRA_API_KEY=
DAFTRA_ACCESS_TOKEN=

DAFTRA_OAUTH_URL=
DAFTRA_OAUTH_CLIENT_ID=
DAFTRA_OAUTH_CLIENT_SECRET=
DAFTRA_OAUTH_USERNAME=
DAFTRA_OAUTH_PASSWORD=
DAFTRA_OAUTH_REFRESH_TOKEN=
DAFTRA_OAUTH_SCOPE=

DAFTRA_PROJECT_COST_CENTER_MAP={}

# ==============================
# CENTRAL WEBHOOK
# ==============================

CENTRAL_WEBHOOK_HOST=127.0.0.1
CENTRAL_WEBHOOK_PORT=4010
CENTRAL_WEBHOOK_JSON_LIMIT=10mb

CENTRAL_WEBHOOK_ADMIN_KEY=
CENTRAL_WEBHOOK_SECRET=
CENTRAL_WEBHOOK_SOURCE_SECRETS_JSON={}
CENTRAL_WEBHOOK_MAX_SKEW_SECONDS=300

CENTRAL_GITHUB_WEBHOOK_SECRET=
CENTRAL_NOTIFY_MIN_SEVERITY=debug
CENTRAL_WEBHOOK_FALLBACK_LOG=./logs/central-webhook-events.jsonl

# ==============================
# WHATSAPP OPERATIONS CENTER
# ==============================

CENTRAL_WHATSAPP_ACCESS_TOKEN=
CENTRAL_WHATSAPP_PHONE_NUMBER_ID=
CENTRAL_WHATSAPP_ADMIN_TO=
CENTRAL_WHATSAPP_VERIFY_TOKEN=
CENTRAL_WHATSAPP_APP_SECRET=

CENTRAL_WHATSAPP_GRAPH_VERSION=v23.0
CENTRAL_WHATSAPP_TIMEOUT_MS=15000

CENTRAL_WHATSAPP_TEMPLATE_NAME=
CENTRAL_WHATSAPP_TEMPLATE_LANGUAGE=ar

CENTRAL_WHATSAPP_FLOW_ID=
CENTRAL_WHATSAPP_FLOW_CTA=أوامر التشغيل
CENTRAL_WHATSAPP_FLOW_SCREEN=MAIN

CENTRAL_WHATSAPP_COMMAND_ALLOWLIST=

# ==============================
# REMOTE OPERATIONS
# ==============================

CENTRAL_COMMAND_PM2_ALLOWLIST=alazab-api,alazab-mcp,alazab-daftra-mcp,alazab-openai-mcp,alazab-central-webhook

CENTRAL_COMMAND_CONFIRM_TTL_SECONDS=300
CENTRAL_COMMAND_TIMEOUT_MS=20000

CENTRAL_PM2_BIN=pm2
CENTRAL_NGINX_BIN=/usr/sbin/nginx
CENTRAL_SYSTEMCTL_BIN=/usr/bin/systemctl

CENTRAL_DAFTRA_HEALTH_URL=http://127.0.0.1:4007/healthz
CENTRAL_REPO_PATH=/var/www/core/alazab-site
