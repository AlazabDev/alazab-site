NODE_ENV=production
PORT=3004
FRONTEND_URL=https://alazab.com

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5434/DATABASE

# Supabase server-side credentials
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Application security
ADMIN_API_KEY=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=

# Optional integrations
WHATSAPP_ACCESS_TOKEN=
PHONE_NUMBER_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
VONAGE_SIGNATURE_SECRET=
VONAGE_VERIFY_WEBHOOK_URL=https://alazab.com/api/vonage/verify/status
VONAGE_TELEGRAM_CHAT_ID=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
DEFAULT_CURRENCY=egp
DEFAULT_TAX_RATE=0

# Azab Daftra MCP v2
MCP_DAFTRA_HOST=127.0.0.1
MCP_DAFTRA_PORT=4007
MCP_DAFTRA_API_KEY=
MCP_DAFTRA_TIMEOUT_MS=60000
MCP_DAFTRA_MAX_RESPONSE_BYTES=26214400
DAFTRA_OPENAPI_FILE=./mcp/daftra/openapi/Default module.openapi.json
DAFTRA_OPENAPI_EXPECT_OPERATIONS=301
DAFTRA_OPENAPI_STRICT_HASH=true
DAFTRA_MCP_AUDIT_FILE=./logs/daftra-mcp-audit.jsonl
DAFTRA_MCP_EXPOSE_GROUP_TOOLS=false

# Daftra account/API connection
DAFTRA_SUBDOMAIN=alazab-co
DAFTRA_BASE_URL=
DAFTRA_API_KEY=
DAFTRA_ACCESS_TOKEN=

# Optional OAuth token management. DAFTRA_OAUTH_URL defaults to
# ${DAFTRA_BASE_URL}/v2/oauth/token (or the derived Daftra base URL).
DAFTRA_OAUTH_URL=
DAFTRA_OAUTH_CLIENT_ID=
DAFTRA_OAUTH_CLIENT_SECRET=
DAFTRA_OAUTH_USERNAME=
DAFTRA_OAUTH_PASSWORD=
DAFTRA_OAUTH_REFRESH_TOKEN=
DAFTRA_OAUTH_SCOPE=

# Optional explicit mapping when a Daftra Project and Cost Center do not share a name.
# JSON object, e.g. {"Arabesque":{"cost_center_id":30},"أربيسك":{"cost_center_id":30}}
DAFTRA_PROJECT_COST_CENTER_MAP={}
